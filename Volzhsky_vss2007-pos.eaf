    <TIER ANNOTATOR="valeriasarapova40-pixel"
        LINGUISTIC_TYPE_REF="default-lt" PARTICIPANT="@vss2007f" TIER_ID="text@vss2007f">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a6"
                TIME_SLOT_REF1="ts20" TIME_SLOT_REF2="ts26">
